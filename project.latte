project(group: "org.lattejava", name: "app", version: "0.1.0", licenses: ["MIT"]) {
  workflow {
    standard()
  }

  publishWorkflow {
    latte()
  }

  dependencies {
    group(name: "compile") {
      dependency(id: "com.fasterxml.jackson.core:jackson-annotations:2.21")
      dependency(id: "com.fasterxml.jackson.core:jackson-core:2.21.1")
      dependency(id: "com.fasterxml.jackson.core:jackson-databind:2.21.1")
      dependency(id: "gg.jte:jte:3.2.1")
      dependency(id: "gg.jte:jte-runtime:3.2.1")
      dependency(id: "io.fusionauth:fusionauth-java-client:1.65.0") {
        exclusion(id: "io.fusionauth:fusionauth-jwt")
      }
      dependency(id: "com.inversoft:restify:4.4.0")
      dependency(id: "org.lattejava:http:0.1.5")
      dependency(id: "org.lattejava:jwt:0.1.0")
      dependency(id: "org.lattejava:web:0.3.0")
    }
    group(name: "test-compile", export: false) {
      dependency(id: "org.testng:testng:7.12.0")
    }
  }

  publications {
    standard()
  }
}

// Plugins
dependency = loadPlugin(id: "org.lattejava.plugin:dependency:0.3.0")
file = loadPlugin(id: "org.lattejava.plugin:file:0.3.0")
idea = loadPlugin(id: "org.lattejava.plugin:idea:0.3.0")
java = loadPlugin(id: "org.lattejava.plugin:java:0.3.0")
javaTestNG = loadPlugin(id: "org.lattejava.plugin:java-testng:0.3.0")
release = loadPlugin(id: "org.lattejava.plugin:release-git:0.3.0")

// Plugin settings
java.settings.javaVersion = "25"
javaTestNG.settings.javaVersion = "25"

target(name: "clean", description: "Cleans the project") {
  java.clean()
}

target(name: "build", description: "Compiles the project, JARs it, and compiles the Tailwind CSS") {
  java.compile()
  java.jar()

  // Compile Tailwind CSS one-shot into web/static/css/app.css (the `tailwind` target below is the
  // watch variant used during development). Ensures the CLI is installed first, like that target.
  if (!new File("node_modules/@tailwindcss/cli").exists()) {
    exec(["npm", "install", "tailwindcss", "@tailwindcss/cli"])
  }
  exec(["npx", "@tailwindcss/cli", "-i", "src/main/css/app.css", "-o", "web/static/css/app.css"])
}

target(name: "test", description: "Runs the project's tests", dependsOn: ["build"]) {
  javaTestNG.test()
}

target(name: "run", description: "Runs the web server", dependsOn: ["build"]) {
  java.run(main: "org.lattejava.app.Main")
}

target(name: "int", description: "Releases a local integration build of the project", dependsOn: ["test"]) {
  dependency.integrate()
}

target(name: "release", description: "Releases a full version of the project", dependsOn: ["clean", "test"]) {
  release.release()
}

target(name: "idea", description: "Updates the IntelliJ IDEA module file") {
  idea.iml()
}

target(name: "bundle", description: "Builds a runnable bundle into `build/bundle`", dependsOn: ["build"]) {
  file.copy(to: "build/bundle/web") {
    fileSet(dir: "web", includePatterns: [/.*/])
  }

  file.copy(to: "build/bundle/lib") {
    fileSet(dir: "build/jars", includePatterns: [/app-${project.version}.jar/])
  }

  file.copy(to: "build/bundle") {
    fileSet(dir: "src/main/scripts", includePatterns: [/app.sh/])
  }

  dependency.copy(to: "build/bundle/lib") {
    dependencies(group: "compile", transitive: true, fetchSource: false, transitiveGroups: ["compile", "runtime"])
    dependencies(group: "runtime", transitive: true, fetchSource: false, transitiveGroups: ["compile", "runtime"])
  }
}

target(name: "deploy", description: "Builds the bundle and deploys the app to Cloudflare (Worker + container)", dependsOn: ["bundle"]) {
  // --env= explicitly targets the top-level (production) environment. The [env.dev] block exists only
  // for local dev D1 migrations, so without this wrangler warns about an ambiguous target environment.
  exec(["npx", "wrangler", "deploy", "--env="])
}

target(name: "tailwind", description: "Installs Tailwind CSS via npm (if needed) and runs it in watch mode against web/**/*.jte") {
  if (!new File("node_modules/@tailwindcss/cli").exists()) {
    exec(["npm", "install", "tailwindcss", "@tailwindcss/cli"])
  }
  exec(["npx", "@tailwindcss/cli", "-i", "src/main/css/app.css", "-o", "web/static/css/app.css", "--watch"])
}

target(name: "minio", description: "Starts a local MinIO container for S3 testing") {
  output.infoln("Stopping MinIO Docker container (if exists)")
  exec("docker rm -f latte-minio", true)

  output.infoln("Starting MinIO Docker container in the background")
  exec("docker run -d --name latte-minio -p 9000:9000 -p 9001:9001 -e MINIO_ROOT_USER=latte-test -e MINIO_ROOT_PASSWORD=latte-test-secret minio/minio server /data --console-address :9001")
  Thread.sleep(1000)

  output.infoln("Initializing MinIO")
  exec("docker exec latte-minio mc alias set local http://localhost:9000 latte-test latte-test-secret")
  exec("docker exec latte-minio mc mb local/latte-test")

  // Allow anonymous downloads so tests can fetch uploaded objects directly over HTTP to verify them.
  exec("docker exec latte-minio mc anonymous set download local/latte-test")
}

private void exec(cmd, boolean ignoreFailure = false) {
  def proc = cmd.execute()
  proc.waitForProcessOutput(System.out, System.err)
  if (!ignoreFailure && proc.exitValue() != 0) {
    fail("Command failed [exit=${proc.exitValue()}]: ${cmd}")
  }
}
