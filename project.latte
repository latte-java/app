project(group: "org.lattejava", name: "app", version: "0.3.0", licenses: ["MIT"]) {
  workflow {
    standard()

    // jOOQ declares Maven dependencies with non-semantic versions (io.r2dbc:r2dbc-spi + its parent POM).
    // jOOQ's module-info `requires` r2dbc.spi, so it must be present; these mappings let Latte resolve it.
    semanticVersions {
      mapping(id: "io.r2dbc:r2dbc-spi:1.0.0.RELEASE", version: "1.0.0")
      mapping(id: "io.r2dbc:r2dbc-spi-parent:1.0.0.RELEASE", version: "1.0.0")
    }
  }

  publishWorkflow {
    latte()
  }

  dependencies {
    group(name: "compile-processors") {
      dependency(id: "org.lattejava:json:0.4.0")
    }
    group(name: "compile") {
      dependency(id: "gg.jte:jte:3.2.1")
      dependency(id: "gg.jte:jte-runtime:3.2.1")
      dependency(id: "org.lattejava:fusionauth:0.4.0")
      dependency(id: "org.lattejava:http:0.3.0")
      dependency(id: "org.lattejava:jwt:0.2.0")
      dependency(id: "org.lattejava:web:0.6.0")
      dependency(id: "org.jooq:jooq:3.21.4")
      // jOOQ's module-info `requires static` these, so javac needs them on the compile module-path (verified:
      // moving them to a runtime group fails compilation). They are not transitively resolved (optional in
      // jOOQ's POM) and tiny (~30 KB each). Must be `compile`; Latte's compile path is fed only by that group.
      dependency(id: "io.r2dbc:r2dbc-spi:1.0.0.RELEASE")
      dependency(id: "org.reactivestreams:reactive-streams:1.0.4")
      dependency(id: "com.zaxxer:HikariCP:7.0.2")
      dependency(id: "org.postgresql:postgresql:42.7.11")
    }
    // Build-only jOOQ code-generation tooling. Never compiled into the app or bundled; assembled into a
    // classpath only by the `codegen` target below.
    group(name: "codegen", export: false) {
      dependency(id: "org.jooq:jooq-codegen:3.21.4")
      dependency(id: "org.jooq:jooq-meta:3.21.4")
      dependency(id: "org.jooq:jooq:3.21.4")
      dependency(id: "org.postgresql:postgresql:42.7.11")
      // jOOQ marks these <optional> in its POM, so they are NOT pulled transitively (verified). The
      // codegen tool needs them at runtime: JAXB (+ activation) to parse the config, and r2dbc-spi +
      // reactive-streams for jOOQ's converter context. Build-only — the app bundle still excludes r2dbc.
      dependency(id: "jakarta.xml.bind:jakarta.xml.bind-api:4.0.2")
      dependency(id: "jakarta.activation:jakarta.activation-api:2.1.3") // jakarta.xml.bind requires it on the module path
      dependency(id: "org.reactivestreams:reactive-streams:1.0.4")
      dependency(id: "io.r2dbc:r2dbc-spi:1.0.0.RELEASE")
    }
    group(name: "test-compile", export: false) {
      dependency(id: "org.testng:testng:7.12.0")
    }
  }

  publications {
    standard()
  }
}

// Plugins
database = loadPlugin(id: "org.lattejava.plugin:database:0.4.0")
dependency = loadPlugin(id: "org.lattejava.plugin:dependency:0.4.0")
file = loadPlugin(id: "org.lattejava.plugin:file:0.4.3")
idea = loadPlugin(id: "org.lattejava.plugin:idea:0.4.1")
java = loadPlugin(id: "org.lattejava.plugin:java:0.4.4")
javaTestNG = loadPlugin(id: "org.lattejava.plugin:java-testng:0.4.0")
release = loadPlugin(id: "org.lattejava.plugin:release-git:0.4.0")

// Plugin settings
database.settings.type = "postgresql"
java.settings.javaVersion = "25"
javaTestNG.settings.javaVersion = "25"

target(name: "clean", description: "Cleans the project") {
  java.clean()
}

target(name: "build", description: "Compiles the project, JARs it, and compiles the Tailwind CSS") {
  file.execute(cmd: "git config core.hooksPath .githooks")

  java.compile()
  java.jar()

  // Compile Tailwind CSS one-shot into web/static/css/app.css (the `tailwind` target below is the
  // watch variant used during development). Ensures the CLI is installed first, like that target.
  if (!new File("node_modules/@tailwindcss/cli").exists()) {
    file.execute(cmd: "npm install tailwindcss @tailwindcss/cli")
  }
  file.execute(cmd: "npx @tailwindcss/cli -i src/main/css/app.css -o web/static/css/app.css")
}

target(name: "test", description: "Runs the project's tests", dependsOn: ["build", "test-database"]) {
  javaTestNG.test()
}

target(name: "run", description: "Runs the web server", dependsOn: ["build"]) {
  java.run(main: "org.lattejava.app.Main")
}

target(name: "main-database", description: "Creates/recreates the main databases and loads the schema.") {
  database.createMainDatabase()
  database.execute(file: "src/main/sql/schema.sql")
  database.execute(file: "src/main/sql/seed.sql")
}

target(name: "test-database", description: "Creates/recreates the test databases and loads the schema.") {
  database.createTestDatabase()
  database.execute(file: "src/main/sql/schema.sql")
}

target(name: "codegen", description: "Generates the jOOQ classes from the live `app` database (run `database --type=main` first)", dependsOn: ["main-database"]) {
  // jOOQ's standalone GenerationTool introspects the live `app` database and writes sources into
  // src/main/java/org/lattejava/app/db/jooq (configured in src/main/jooq/codegen.xml). It runs off the
  // build-only `codegen` dependency group (the tool + driver), never the app's compile/runtime path.
  // jOOQ runs on the module path here. Its `requires static` optionals (JAXB for config parsing,
  // r2dbc/reactive-streams for the converter context) aren't auto-resolved, so add them; and its config
  // unmarshaller reflects from org.jooq into org.jooq.meta.jaxb, which needs an explicit opens.
  java.run(
      main: "org.jooq.codegen.GenerationTool",
      arguments: "src/main/jooq/codegen.xml",
      jvmArguments: "--add-modules jakarta.xml.bind,r2dbc.spi,org.reactivestreams --add-opens org.jooq.meta/org.jooq.meta.jaxb=org.jooq",
      dependencies: [[group: "codegen", transitive: true, fetchSource: false, transitiveGroups: ["compile", "runtime"]]]
  )
}

target(name: "int", description: "Releases a local integration build of the project", dependsOn: ["test"]) {
  dependency.integrate()
}

target(name: "release", description: "Releases a full version of the project", dependsOn: ["clean", "test"]) {
  release.release()
}

target(name: "idea", description: "Updates the IntelliJ IDEA module file") {
  idea.iml()
}

target(name: "bundle", description: "Builds a runnable bundle into `build/bundle`", dependsOn: ["build"]) {
  file.copy(to: "build/bundle/web") {
    fileSet(dir: "web", includePatterns: [/.*/])
  }

  file.copy(to: "build/bundle/lib") {
    fileSet(dir: "build/jars", includePatterns: [/app-${project.version}.jar/])
  }

  file.copy(to: "build/bundle") {
    fileSet(dir: "src/main/scripts", includePatterns: [/app.sh/])
  }

  dependency.copy(to: "build/bundle/lib") {
    dependencies(group: "compile", transitive: true, fetchSource: false, transitiveGroups: ["compile", "runtime"])
    dependencies(group: "runtime", transitive: true, fetchSource: false, transitiveGroups: ["compile", "runtime"])
  }
}

target(name: "deploy", description: "Builds the bundle and deploys the app to Cloudflare (Worker + container)", dependsOn: ["bundle"]) {
  file.execute(cmd: "npx wrangler deploy")
}

target(name: "tailwind", description: "Installs Tailwind CSS via npm (if needed) and runs it in watch mode against web/**/*.jte") {
  if (!new File("node_modules/@tailwindcss/cli").exists()) {
    file.execute(cmd: "npm install tailwindcss @tailwindcss/cli")
  }
  file.execute(cmd: "npx @tailwindcss/cli -i src/main/css/app.css -o web/static/css/app.css --watch")
}

target(name: "minio", description: "Starts a local MinIO container for S3 testing") {
  output.infoln("Stopping MinIO Docker container (if exists)")
  file.execute(cmd: "docker rm -f latte-minio", ignoreFailures: true)

  output.infoln("Starting MinIO Docker container in the background")
  file.execute(cmd: "docker run -d --name latte-minio -p 9000:9000 -p 9001:9001 -e MINIO_ROOT_USER=latte-test -e MINIO_ROOT_PASSWORD=latte-test-secret minio/minio server /data --console-address :9001")
  Thread.sleep(1000)

  output.infoln("Initializing MinIO")
  file.execute(cmd: "docker exec latte-minio mc alias set local http://localhost:9000 latte-test latte-test-secret")
  file.execute(cmd: "docker exec latte-minio mc mb local/latte-test")

  // Allow anonymous downloads so tests can fetch uploaded objects directly over HTTP to verify them.
  file.execute(cmd: "docker exec latte-minio mc anonymous set download local/latte-test")
}
