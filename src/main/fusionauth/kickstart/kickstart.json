{
  "licenseId": "#{ENV.FUSIONAUTH_APP_LICENSE_KEY}",
  "variables": {
    "apiKey": "33052c8a-c283-4e96-9d2a-eb1215c69f8f-not-for-prod",
    "asymmetricKeyId": "#{UUID()}",
    "applicationId": "e9fdb985-9173-4e01-9d73-ac2d60d1dc8e",
    "clientSecret": "super-secret-secret-that-should-be-regenerated-for-production",
    "defaultTenantId": "d7d09513-a3f5-401c-9685-34ab6c552453",
    "adminEmail": "admin@lattejava.org",
    "adminPassword": "password",
    "adminUserId": "#{UUID()}",
    "ordinaryEmail": "test@lattejava.org",
    "ordinaryPassword": "password",
    "ordinaryUserId": "#{UUID()}",
    "githubIdpId": "bef65e1f-0ecf-4c7a-93cb-f58c3ce10b72",
    "accessTokenPopulateLambdaId": "9bde7abd-5557-41cc-9a40-1048cac3f64e",
    "inviteEmailTemplateId": "a4db4962-efd8-476d-af15-932567f337b8",
    "setPasswordEmailTemplateId": "9ada7df9-914e-4bd6-9e24-6c11abb1ed3f",
    "themeId": "c1d7e3a4-6b2f-4e8a-9f1c-5a0d8b3e2f10",
    "emailFieldId":               "#{UUID()}",
    "passwordFieldId":            "#{UUID()}",
    "usernameFieldId":            "#{UUID()}",
    "registrationFormId":         "#{UUID()}",
    "selfServiceEmailFieldId":    "#{UUID()}",
    "selfServiceUsernameFieldId": "#{UUID()}",
    "selfServiceFormId":          "#{UUID()}"
  },
  "apiKeys": [
    {
      "key": "#{apiKey}",
      "description": "Unrestricted API key"
    }
  ],
  "requests": [
    {
      "method": "POST",
      "url": "/api/key/generate/#{asymmetricKeyId}",
      "tenantId": "#{defaultTenantId}",
      "body": {
        "key": {
          "algorithm": "RS256",
          "name": "For Latte App",
          "length": 2048
        }
      }
    },
    {
      "method": "POST",
      "url": "/api/email/template/#{inviteEmailTemplateId}",
      "body": {
        "emailTemplate": {
          "name": "[Latte] Group Invitation",
          "fromEmail": "noreply@lattejava.org",
          "defaultFromName": "Latte Java",
          "defaultSubject": "You've been invited to ${groupName!'a Latte Java group'}",
          "defaultHtmlTemplate": "@{emails/group-invitation.html.ftl}",
          "defaultTextTemplate": "@{emails/group-invitation.txt.ftl}"
        }
      }
    },
    {
      "method": "POST",
      "url": "/api/email/template/#{setPasswordEmailTemplateId}",
      "body": {
        "emailTemplate": {
          "name": "[Latte] Set Password (Invitation)",
          "fromEmail": "noreply@lattejava.org",
          "defaultFromName": "Latte Java",
          "defaultSubject": "Set your Latte Java password",
          "defaultHtmlTemplate": "@{emails/set-password.html.ftl}",
          "defaultTextTemplate": "@{emails/set-password.txt.ftl}"
        }
      }
    },
    {
      "method": "POST",
      "url": "/api/theme/#{themeId}",
      "body": {
        "theme": {
          "name": "Latte Java",
          "type": "simple",
          "variables": {
            "pageBackgroundColor": "#f8fafc",
            "panelBackgroundColor": "#ffffff",
            "fontColor": "#0f172b",
            "primaryButtonColor": "#00a6f4",
            "primaryButtonFocusColor": "#0084d1",
            "primaryButtonTextColor": "#ffffff",
            "primaryButtonTextFocusColor": "#ffffff",
            "linkTextColor": "#0084d1",
            "linkTextFocusColor": "#0069a8",
            "deleteButtonColor": "#e7000b",
            "deleteButtonFocusColor": "#c10007",
            "deleteButtonTextColor": "#ffffff",
            "deleteButtonTextFocusColor": "#ffffff",
            "inputBackgroundColor": "#ffffff",
            "inputTextColor": "#0f172b",
            "inputIconColor": "#90a1b9",
            "iconColor": "#45556c",
            "iconBackgroundColor": "#f1f5f9",
            "alertBackgroundColor": "#dff2fe",
            "alertFontColor": "#024a70",
            "errorFontColor": "#c10007",
            "errorIconColor": "#e7000b",
            "infoIconColor": "#0084d1",
            "monoFontColor": "#0f172b",
            "borderRadius": "8px",
            "fontFamily": "Inter, ui-sans-serif, system-ui, sans-serif",
            "monoFontFamily": "JetBrains Mono, ui-monospace, monospace",
            "logoImageURL": "http://localhost:8080/static/images/logo.svg",
            "logoImageSize": "10rem",
            "favicons": [
              { "href": "http://localhost:8080/static/favicon-32x32.png", "rel": "icon", "type": "image/png" },
              { "href": "http://localhost:8080/static/favicon-16x16.png", "rel": "icon", "type": "image/png" }
            ]
          }
        }
      }
    },
    {
      "method": "PATCH",
      "url": "/api/tenant/#{defaultTenantId}",
      "body": {
        "tenant": {
          "issuer": "http://localhost:9011",
          "themeId": "#{themeId}",
          "emailConfiguration": {
            "host": "mailcatcher",
            "port": 1025,
            "defaultFromEmail": "noreply@lattejava.org",
            "defaultFromName": "Latte Java",
            "implicitEmailVerificationAllowed": true,
            "setPasswordEmailTemplateId": "#{setPasswordEmailTemplateId}"
          },
          "webAuthnConfiguration": {
            "enabled": true,
            "debug": false,
            "relyingPartyId": "localhost",
            "relyingPartyName": "Latte Java",
            "bootstrapWorkflow": {
              "enabled": true,
              "authenticatorAttachmentPreference": "platform",
              "userVerificationRequirement": "required"
            },
            "reauthenticationWorkflow": {
              "enabled": true,
              "authenticatorAttachmentPreference": "platform",
              "userVerificationRequirement": "required"
            }
          }
        }
      }
    },
    {
      "method": "POST",
      "url": "/api/form/field/#{emailFieldId}",
      "body": {
        "field": {
          "key": "user.email",
          "name": "[Latte Registration] Email",
          "required": true
        }
      }
    },
    {
      "method": "POST",
      "url": "/api/form/field/#{usernameFieldId}",
      "body": {
        "field": {
          "key": "user.username",
          "name": "[Latte Registration] Username",
          "required": true
        }
      }
    },
    {
      "method": "POST",
      "url": "/api/form/field/#{passwordFieldId}",
      "body": {
        "field": {
          "key": "user.password",
          "name": "[Latte Registration] Password",
          "required": true
        }
      }
    },
    {
      "method": "POST",
      "url": "/api/form/#{registrationFormId}",
      "body": {
        "form": {
          "name": "Default Registration",
          "type": "registration",
          "steps": [
            {
              "type": "collectData",
              "fields": [
                "#{emailFieldId}",
                "#{usernameFieldId}",
                "#{passwordFieldId}"
              ]
            }
          ]
        }
      }
    },
    {
      "method": "POST",
      "url": "/api/form/field/#{selfServiceEmailFieldId}",
      "body": {
        "field": {
          "key": "user.email",
          "name": "[Latte Account] Email",
          "required": true
        }
      }
    },
    {
      "method": "POST",
      "url": "/api/form/field/#{selfServiceUsernameFieldId}",
      "body": {
        "field": {
          "key": "user.username",
          "name": "[Latte Account] Username",
          "required": true
        }
      }
    },
    {
      "method": "POST",
      "url": "/api/form/#{selfServiceFormId}",
      "body": {
        "form": {
          "name": "Latte Account Management",
          "type": "selfServiceUser",
          "steps": [
            {
              "type": "collectData",
              "fields": [
                "#{selfServiceEmailFieldId}",
                "#{selfServiceUsernameFieldId}"
              ]
            }
          ]
        }
      }
    },
    {
      "method": "POST",
      "url": "/api/lambda/#{accessTokenPopulateLambdaId}",
      "body": {
        "lambda": {
          "name": "[Latte] Access token populate",
          "type": "JWTPopulate",
          "engineType": "GraalJS",
          "body": "function populate(jwt, user, registration) {\n  jwt.preferred_username = user.username;\n  jwt.email = user.email;\n}"
        }
      }
    },
    {
      "method": "POST",
      "url": "/api/application/#{applicationId}",
      "tenantId": "#{defaultTenantId}",
      "body": {
        "application": {
          "name": "Latte App",
          "oauthConfiguration": {
            "authorizedRedirectURLs": [
              "http://localhost:8080/oidc/logout-return",
              "http://localhost:8080/oidc/return",
              "http://localhost:8081/oidc/logout-return",
              "http://localhost:8081/oidc/return"
            ],
            "logoutURL": "http://localhost:8080/oidc/logout-return",
            "clientSecret": "#{clientSecret}",
            "enabledGrants": [
              "authorization_code",
              "refresh_token"
            ],
            "generateRefreshTokens": true,
            "requireRegistration": true
          },
          "jwtConfiguration": {
            "enabled": true,
            "accessTokenKeyId": "#{asymmetricKeyId}",
            "idTokenKeyId": "#{asymmetricKeyId}"
          },
          "lambdaConfiguration": {
            "accessTokenPopulateId": "#{accessTokenPopulateLambdaId}"
          },
          "registrationConfiguration": {
            "enabled": true,
            "type": "advanced",
            "formId": "#{registrationFormId}"
          },
          "formConfiguration": {
            "selfServiceFormId": "#{selfServiceFormId}"
          }
        }
      }
    },
    {
      "method": "POST",
      "url": "/api/identity-provider/#{githubIdpId}",
      "body": {
        "identityProvider": {
          "type": "OpenIDConnect",
          "name": "GitHub",
          "enabled": true,
          "buttonText": "Sign in with GitHub",
          "linkingStrategy": "LinkByEmail",
          "oauth2": {
            "authorization_endpoint": "https://github.com/login/oauth/authorize",
            "token_endpoint": "https://github.com/login/oauth/access_token",
            "userinfo_endpoint": "https://api.github.com/user",
            "clientAuthenticationMethod": "client_secret_basic",
            "client_id": "#{ENV.FUSIONAUTH_APP_GITHUB_CLIENT_ID}",
            "client_secret": "#{ENV.FUSIONAUTH_APP_GITHUB_CLIENT_SECRET}",
            "scope": "read:user user:email read:org",
            "uniqueIdClaim": "id",
            "emailClaim": "email",
            "usernameClaim": "login"
          },
          "applicationConfiguration": {
            "#{applicationId}": {
              "enabled": true,
              "createRegistration": true
            }
          }
        }
      }
    },
    {
      "method": "POST",
      "url": "/api/user/registration/#{adminUserId}",
      "body": {
        "registration": {
          "applicationId": "#{FUSIONAUTH_APPLICATION_ID}",
          "roles": [
            "admin"
          ]
        },
        "skipRegistrationVerification": true,
        "user": {
          "email": "#{adminEmail}",
          "username": "AdminUser",
          "password": "#{adminPassword}"
        }
      }
    },
    {
      "method": "POST",
      "url": "/api/user/registration/#{ordinaryUserId}",
      "body": {
        "registration": {
          "applicationId": "#{applicationId}"
        },
        "skipRegistrationVerification": true,
        "user": {
          "email": "#{ordinaryEmail}",
          "username": "OrdinaryUser",
          "password": "#{ordinaryPassword}"
        }
      }
    }
  ]
}
